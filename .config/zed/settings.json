// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "kilo": {
      "type": "registry"
    }
  },
  "auto_update": false,
  "edit_predictions": {
    "provider": "zed"
  },
  "context_servers": {
    "linear": {
      "enabled": true,
      "url": "https://mcp.linear.app/mcp"
    },
    "resend": {
      "enabled": true,
      "url": "https://mcp.resend.com/mcp"
    }
  },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "profiles": {
      "elvis": {
        "default_model": {
          "provider": "anthropic",
          "model": "claude-sonnet-4-6-latest",
          "enable_thinking": true,
          "effort": "high"
        },
        "name": "Elvis",
        "tools": {
          "fetch": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "tool_permissions": {
      "tools": {
        "mcp:linear:list_issues": {
          "default": "allow"
        },
        "mcp:resend:send-email": {
          "default": "allow"
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://www\\.braintrust\\.dev"
            },
            {
              "pattern": "^https?://fiddler\\.ai"
            },
            {
              "pattern": "^https?://confident\\-ai\\.com"
            }
          ]
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "high",
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "on_last_window_closed": "platform_default",
  "use_system_prompts": false,
  "use_system_path_prompts": false,
  "base_keymap": "VSCode",
  "buffer_font_family": "MonoLisa",
  "buffer_font_size": 14.0,
  "buffer_line_height": {
    "custom": 1.8180000305175781,
  },
  "colorize_brackets": true,
  "gutter": {
    "line_numbers": true,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "linked_edits": true,
  "minimap": {
    "thumb": "always",
  },
  "preview_tabs": {
    "enabled": false,
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
    "auto_reveal_entries": false,
  },
  "relative_line_numbers": "enabled",
  "restore_on_startup": "empty_tab",
  "show_edit_predictions": true,
  "show_whitespaces": "boundary",
  "sticky_scroll": {
    "enabled": true,
  },
  "tabs": {
    "activate_on_close": "left_neighbour",
    "show_close_button": "hidden",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Monokai Vibrant Amped"
  },
  "ui_font_family": "MonoLisa",
  "ui_font_size": 14.0,
  "use_auto_surround": false,
  "vertical_scroll_margin": 7.0,
  "vim_mode": true,
  "when_closing_with_no_tabs": "close_window",
}
