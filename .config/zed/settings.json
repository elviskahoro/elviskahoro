  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "cline": {
      "type": "registry"
    },
    "kilo": {
      "type": "registry"
    }
  },
  "auto_update": false,
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed"
  },
  "context_servers": {
    "attio": {
      "enabled": true,
      "url": "https://mcp.attio.com/mcp"
    },
    "exa": {
      "enabled": true,
      "url": "https://mcp.exa.ai/mcp"
    },
    "linear": {
      "enabled": true,
      "url": "https://mcp.linear.app/mcp"
    },
    "resend": {
      "enabled": true,
      "url": "https://mcp.resend.com/mcp"
    }
  },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "threads_sidebar": {
      "position": "left"
    },
    "thinking_display": "always_expanded",
    "single_file_review": true,
    "profiles": {
      "elvis": {
        "default_model": {
          "provider": "zed.dev",
          "model": "claude-sonnet-5",
          "enable_thinking": true,
          "effort": "high"
        },
        "name": "Elvis",
        "tools": {
          "fetch": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "restore_file_from_disk": {
          "default": "allow"
        },
        "edit_file": {
          "always_allow": [
            {
              "pattern": "^isabel\\-may/\\.zed/"
            }
          ]
        },
        "open": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        },
        "mcp:linear:list_issues": {
          "default": "allow"
        },
        "mcp:resend:send-email": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^https?://www\\.braintrust\\.dev"
            },
            {
              "pattern": "^https?://fiddler\\.ai"
            },
            {
              "pattern": "^https?://confident\\-ai\\.com"
            }
          ]
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "allow_fs_write_all": true,
      "allow_unsandboxed": true
    },
    "default_model": {
      "provider": "Fireworks",
      "model": "accounts/fireworks/models/deepseek-v4p1-flash",
      "enable_thinking": false
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "~z-ai/glm-flash-latest",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
