tmp/
.claude/*
!.claude/settings.json
!.claude/themes/
!.claude/hooks/
!.claude/hooks/**
.mcp.json
# Local env files — secrets stay out of git
.env
.env.*
*.env
!.env.example
# Beacon sidecar runtime artifacts — secrets + rotating logs stay local only
.beacon/sidecar/infisical.env
.beacon/sidecar/sidecar.log
# Warp's own downloaded TUI-preview build (binary + bundled skills)
.warp/tui-preview/
# Warp's downloaded TUI executable
.warp/tui/versions/*/warp-tui-stable
# Skill sync tool's trash of replaced skill copies
.agents/skills/.trash/
# Synced skills published by Anthropic (manifest source: anthropic / anthropic-example),
# not authored here. Includes the Microsoft Office ones (docx/pptx/xlsx).
# Own skills (manifest source: plugin) stay tracked.
.agents/skills/synced/*/docx/
.agents/skills/synced/*/pptx/
.agents/skills/synced/*/xlsx/
.agents/skills/synced/*/pdf/
.agents/skills/synced/*/docs/
.agents/skills/synced/*/google-workspace/
.agents/skills/synced/*/import-memory/
.agents/skills/synced/*/morning/
.agents/skills/synced/*/skill-creator/
.agents/skills/synced/*/built-in-browser/
.agents/skills/synced/*/chrome-browser/
.agents/skills/synced/*/computer-use/
.agents/skills/synced/*/deep-research/
.agents/skills/synced/*/theme-factory/
