tmp/
.claude/*
!.claude/settings.json
!.claude/themes/
!.claude/hooks/
!.claude/hooks/**
.mcp.json
# Local env files — secrets stay out of git
.env
.env.*
*.env
!.env.example
# Beacon sidecar runtime artifacts — secrets + rotating logs stay local only
.beacon/sidecar/infisical.env
.beacon/sidecar/sidecar.log
# Warp's own downloaded TUI-preview build (binary + bundled skills)
.warp/tui-preview/
# Warp's downloaded TUI executable
.warp/tui/versions/*/warp-tui-stable
# Skill sync tool's trash of replaced skill copies
.agents/skills/.trash/
# Skills synced from Claude cloud into synced/<account>/<skill>/ (Anthropic-published
# docx/pptx/xlsx/etc. and account plugin skills) are not authored here. Ignore every
# skill dir; the sync-state files directly in each bucket (manifest.json,
# .last-complete-round) stay tracked.
.agents/skills/synced/*/*/
# Hotdata CLI re-creates this symlink into ~/.agents/skills on update
.agents/skills/hotdata
